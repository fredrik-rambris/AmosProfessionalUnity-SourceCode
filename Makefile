# Linux build of AMOS Professional Unity.
#
# Mirrors the AmigaDOS "Build" script and the *.batch files it executes:
# assembling is done with c/genam and c/genim2 running under vamos, while
# the AMOS-compiled helper tools in c/ are replaced by the C ports in tools/.
# See CLAUDE.md for the mapping between batch files and targets.
#
# Paths below must use the exact on-disk case (the C tools and make itself
# are case-sensitive); the Include lines inside the sources don't matter
# since vamos resolves those case-insensitively.

CC      ?= cc
CFLAGS  ?= -O2 -Wall

SHELL   := bash
MAKEFLAGS += -s

OUT     := AmosProfessionalUnity
SYS     := $(OUT)/APUSystem
CFG     := $(OUT)/Unity_Extras/Configurations
TMP     := tmpCompil
LOGS    := logs
GENAM   := c/genam
GENIM2  := c/genim2

# vamos defaults to too little emulated RAM for genim2 on the .library
# sources ("Error out of memory"); 8 MB is enough, and the 24-bit 68000
# address space (with hardware access enabled) caps it below 16 MB.
VAMOS_FLAGS ?= -m 8192

# Git revision holding the reference binaries for "make compare".
REF     ?= HEAD

# AmigaDOS return codes: 0=OK, 5=WARN, 10=ERROR, 20=FAIL. Genam/Genim2 exit
# 5 on things like "Warning sign extended operand" even with 0 errors found,
# which vamos passes straight through - so 0 and 5 are success, anything
# else is fatal (including 1, which is what vamos itself returns when it
# can't start, e.g. a missing Python module).
# Output is piped through iconv (the tools' banners/messages are Latin-1)
# for a UTF-8 terminal and tee'd to logs/<name>.logs like the batch files
# do; PIPESTATUS[0] (a bash-ism, hence SHELL:=bash above) gets vamos's exit
# code rather than iconv's or tee's.
# $(1) = command line, $(2) = log name
define run_vamos
mkdir -p $(LOGS); vamos $(VAMOS_FLAGS) -- $(1) 2>&1 | iconv -f latin1 -t utf8 | tee $(LOGS)/$(2).logs; st=$${PIPESTATUS[0]}; if [ $$st -ne 0 ] && [ $$st -ne 5 ]; then echo "*** $(2) failed with return code $$st, see $(LOGS)/$(2).logs"; exit $$st; fi
endef

# Prints a status line, bolded/colored when stdout is a terminal that
# supports it (and NO_COLOR isn't set), plain text otherwise (a log file,
# `make | cat`, a dumb terminal, ...).
define status
if [ -t 1 ] && [ -z "$$NO_COLOR" ] && tput setaf 1 >/dev/null 2>&1; then printf '\n\033[1;36m==> %s\033[0m\n' "$(1)"; else printf '\n==> %s\n' "$(1)"; fi
endef

# --- shared sources ---------------------------------------------------------
LIB_SRC   := src/AmosProUnity_lib/AmosProUnity_Lib.s
ILIB_SRC  := src/AmosProUnity_lib/AmosProUnity_ILib.s
# Generated by Make_Labels but git-tracked; included by src/Amos_Includes.s,
# so (nearly) everything depends on it.
LEQU      := src/AMOSProUnity_lib_Equ.s

LABEL_OUTPUTS := \
  $(LEQU) \
  $(TMP)/Internal_Jumps.s \
  $(TMP)/AmosProUnity_ILib_Size.s \
  $(TMP)/AmosProUnity_ILib_Functions.s \
  $(TMP)/AmosProUnity_Lib_Size.s

TOKTAB    := $(TMP)/Toktab_Verif.Bin

# Everything pulled in through src/Amos_Includes.s
ASM_DEPS := \
  src/Amos_Includes.s \
  src/AmosProUnity_Equ.s \
  $(wildcard src/AmosProUnity_Equates/*.s) \
  src/AmosProUnity_CEqu.s \
  src/AmosProUnity_Debug.s \
  src/AmosProUnity_library_equ.s \
  src/AmosProUnity_Version.s \
  includesSAGA/sagaRegisters.h \
  $(LEQU)

COMMON_LIBRARY_SRCS := $(wildcard src/AmosProUnityCommon_Library/*.s)

# --- outputs ----------------------------------------------------------------
# Names follow the git-tracked files (which sometimes differ in case from
# what the batch files write, e.g. AMOSProUnity_Music.Lib vs .lib).
LIB_OUT      := $(SYS)/AmosProUnity.Lib
LIBRARY_OUTS := $(foreach v,ECS AGA SAGA,$(SYS)/AMOSProUnity$(v).library $(OUT)/Libs/AMOSProUnity$(v).library)
EXE_OUT      := $(OUT)/AmosProfessionalUnity
CONFIG_OUTS  := \
  $(CFG)/AmosProUnity_Editor_Config.Backup $(SYS)/AmosProUnity_Editor_Config \
  $(CFG)/AMOSProUnity_Interpreter_Config.Backup $(SYS)/AMOSProUnity_Interpreter_Config
EDITOR_OUT   := $(SYS)/AMOSProUnity_Editor
MONITOR_OUT  := $(SYS)/AMOSProUnity_Monitor
LIBS_OUTS    := \
  $(SYS)/AMOSProUnity_Music.Lib \
  $(SYS)/AMOSProUnity_Compact.Lib \
  $(SYS)/AMOSProUnity_Request.Lib \
  $(SYS)/AMOSProUnity_IOPorts.Lib \
  $(SYS)/AMOSProUnity_Support.Lib
EXT_OUTS     := $(SYS)/AMOSProUnity_SpecialFX.Lib
COMPILER_OUTS := \
  $(CFG)/AMOSProUnity_Compiler_Config.Backup $(OUT)/S/AMOSProUnity_Compiler_Config \
  $(SYS)/APUCmp \
  $(SYS)/Compiler.Lib \
  $(SYS)/AMOSProUnity_Compiler.Lib \
  $(SYS)/Header_CLI.Lib \
  $(SYS)/Header_Backstart.Lib

ALL_OUTS := $(LIB_OUT) $(LIBRARY_OUTS) $(EXE_OUT) $(CONFIG_OUTS) $(EDITOR_OUT) \
  $(MONITOR_OUT) $(LIBS_OUTS) $(EXT_OUTS) $(COMPILER_OUTS)

# Library_Digest outputs that aren't git-tracked (removed by "clean")
DIGEST_OUTS :=

# --- top-level targets (same order as Build) ---------------------------------
.PHONY: all tools lib library exe configs editor monitor libs extensions compiler \
        amcaf personal checklist compare clean
.DEFAULT_GOAL := all

all: lib library exe configs editor monitor libs extensions compiler
	$(call status,Build complete - release in $(OUT)/)

lib:        $(LIB_OUT)
library:    $(LIBRARY_OUTS)
exe:        $(EXE_OUT)
configs:    $(CONFIG_OUTS)
editor:     $(EDITOR_OUT)
monitor:    $(MONITOR_OUT)
libs:       $(LIBS_OUTS)
extensions: $(EXT_OUTS)
compiler:   $(COMPILER_OUTS)

# --- tools ------------------------------------------------------------------
TOOL_SRCS := $(wildcard tools/*.c)
TOOL_BINS := $(filter-out tools/common,$(TOOL_SRCS:.c=))

tools: $(TOOL_BINS)

tools/%: tools/%.c tools/common.h tools/common.c
	$(CC) $(CFLAGS) -I tools -o $@ tools/common.c $<

$(TMP) $(SYS) $(OUT)/Libs $(OUT)/S $(CFG):
	mkdir -p $@

# --- AMOSProUnity_Lib.batch -------------------------------------------------
$(TOKTAB): $(LIB_SRC) tools/Make_Toktable | $(TMP)
	tools/Make_Toktable $(LIB_SRC) $@

$(LABEL_OUTPUTS) &: $(ILIB_SRC) $(LIB_SRC) tools/Make_Labels | $(TMP)
	tools/Make_Labels $(ILIB_SRC) $(LIB_SRC) $(LABEL_OUTPUTS)

$(LIB_OUT): $(LIB_SRC) $(ILIB_SRC) $(LABEL_OUTPUTS) $(TOKTAB) $(ASM_DEPS) \
            src/APULib_UnitySupport/UnitySupport_Equ.s src/bin/Dialog_Funcs.bin | $(SYS)
	$(call status,Assembling AmosProUnity.Lib)
	$(call run_vamos,$(GENAM) FROM $(LIB_SRC) TO $@,AmosProUnity.Lib)

# --- AMOSProUnity_library.batch ---------------------------------------------
# $(1) = ECS/AGA/SAGA
define LIBRARY_RULES
$(SYS)/AMOSProUnity$(1).library: src/AmosProUnity_Library$(1).s $(wildcard src/AmosProUnity$(1)_Library/*.s) \
        $(COMMON_LIBRARY_SRCS) $(ASM_DEPS) src/bin/WFont.bin src/bin/ReqPic.bin src/bin/AMOSPro_Mouse.abk | $(SYS)
	$$(call status,Assembling AMOSProUnity$(1).library)
	$$(call run_vamos,$(GENIM2) src/AmosProUnity_Library$(1).s -o$$@ -C,AMOSProUnity$(1).library)

$(OUT)/Libs/AMOSProUnity$(1).library: $(SYS)/AMOSProUnity$(1).library | $(OUT)/Libs
	cp $$< $$@
endef
$(foreach v,ECS AGA SAGA,$(eval $(call LIBRARY_RULES,$(v))))

# --- AMOSProUnity_Exe.batch -------------------------------------------------
$(EXE_OUT): src/AmosProUnity/AmosProUnity_Loaders.s src/AmosProUnity_Verif.s \
            $(TMP)/Internal_Jumps.s $(ASM_DEPS) includes/exec/execbase.i
	$(call status,Assembling AmosProfessionalUnity)
	$(call run_vamos,$(GENAM) FROM src/AmosProUnity/AmosProUnity_Loaders.s TO $@,AmosProfessionalUnity)

# --- AMOSProUnity_ConfigsWithExt.batch / config part of _Compiler.batch ------
# genim2 the source into tmpCompil, extract the data chunk with Get_Chunk
# into Unity_Extras/Configurations/<name>.Backup, then install a copy.
# $(1) = source, $(2) = object/backup base name, $(3) = installed copy,
# $(4) = extra deps
define CONFIG_RULES
$(CFG)/$(2).Backup: $(1) $(4) tools/Get_Chunk | $(TMP) $(CFG)
	$$(call status,Assembling $(2))
	$$(call run_vamos,$(GENIM2) $(1) -o$(TMP)/$(2).o,$(2))
	tools/Get_Chunk $(TMP)/$(2).o $$@

$(3): $(CFG)/$(2).Backup
	mkdir -p $$(@D)
	cp $$< $$@
endef
$(eval $(call CONFIG_RULES,src/Configuration/APUnity_Editor_Config.s,AmosProUnity_Editor_Config,$(SYS)/AmosProUnity_Editor_Config,src/AmosProUnity_Equ.s $(wildcard src/AmosProUnity_Equates/*.s) src/bin/Editor_Menus.Asc src/bin/Editor_Menus.Bin))
$(eval $(call CONFIG_RULES,src/Configuration/APUnity_Interpreter_Config_withExt.s,AMOSProUnity_Interpreter_Config,$(SYS)/AMOSProUnity_Interpreter_Config,))
$(eval $(call CONFIG_RULES,src/Compiler/Compiler_Config.s,AMOSProUnity_Compiler_Config,$(OUT)/S/AMOSProUnity_Compiler_Config,))

# --- AMOSProUnity_Editor.batch / AMOSProUnity_Monitor.batch -----------------
$(EDITOR_OUT): src/AmosProUnity_Editor/AmosProUnity_Editor.s $(ASM_DEPS) | $(SYS)
	$(call status,Assembling AMOSProUnity_Editor)
	$(call run_vamos,$(GENAM) FROM $< TO $@,AMOSProUnity_Editor)

$(MONITOR_OUT): src/AmosProUnity_Monitor/AmosProUnity_Monitor.s $(ASM_DEPS) | $(SYS)
	$(call status,Assembling AMOSProUnity_Monitor)
	$(call run_vamos,$(GENAM) FROM $< TO $@,AMOSProUnity_Monitor)

# --- Library_Digest + genam libraries (lib_*.batch, Compiler.batch) ---------
# Library_Digest writes <base>_Labels.s and <base>_Size.s next to the source.
# $(1) = source, $(2) = output, $(3) = extra deps, $(4) = extra recipe line
define DIGEST_LIB
$(basename $(1))_Labels.s $(basename $(1))_Size.s &: $(1) tools/Library_Digest
	tools/Library_Digest $(1)

$(2): $(1) $(basename $(1))_Labels.s $(basename $(1))_Size.s $(ASM_DEPS) $(3) | $(SYS)
	$$(call status,Assembling $$(@F))
	$(4)
	$$(call run_vamos,$(GENAM) FROM $(1) TO $$@,$$(@F))
endef

# digest_lib: rules only (for libraries whose digests are git-tracked);
# digest_lib_clean: rules + digests removed by "make clean"
digest_lib = $(eval $(call DIGEST_LIB,$(1),$(2),$(3),$(4)))
digest_lib_clean = $(call digest_lib,$(1),$(2),$(3),$(4))$(eval DIGEST_OUTS += $(basename $(1))_Labels.s $(basename $(1))_Size.s)

# lib_Music/Compact/Request/IOPorts/UnitySupport.batch
$(call digest_lib_clean,src/APULib_Music/APUMusic_lib.s,$(SYS)/AMOSProUnity_Music.Lib)
$(call digest_lib_clean,src/APULib_Compact/APUCompact_lib.s,$(SYS)/AMOSProUnity_Compact.Lib)
$(call digest_lib_clean,src/APULib_Request/APURequest_lib.s,$(SYS)/AMOSProUnity_Request.Lib)
$(call digest_lib_clean,src/APULib_IOPorts/APUIOPorts_lib.s,$(SYS)/AMOSProUnity_IOPorts.Lib)
$(call digest_lib_clean,src/APULib_UnitySupport/UnitySupport_lib.s,$(SYS)/AMOSProUnity_Support.Lib,src/APULib_UnitySupport/UnitySupport_Equ.s src/APULib_UnitySupport/iffIlbm_Equ.s)
# lib_SpecialFXUnity.batch
$(call digest_lib_clean,src/APULib_SpecialFX/AMOSProUnity_SpecialFX.s,$(SYS)/AMOSProUnity_SpecialFX.Lib)
# AMOSProUnity_Compiler.batch
$(call digest_lib_clean,src/Compiler/CLib.s,$(SYS)/Compiler.Lib,tools/Check_Clib,tools/Check_Clib $(LEQU) src/Compiler/CLib.s)
$(call digest_lib_clean,src/Compiler/CompExt.s,$(SYS)/AMOSProUnity_Compiler.Lib)
# Optional, commented out in Build (their digests are git-tracked)
$(call digest_lib,src/APULib_Amcaf/AMOSProUnity_AMCAF.s,$(SYS)/AMOSProUnity_AMCAF.Lib,src/APULib_Amcaf/AMOSPro_AMCAF_DataZones.s)
$(call digest_lib,src/APULib_SpecialFX/AMOSProUnity_Personal.s,$(SYS)/AMOSProUnity_Personal.Lib)

amcaf:    $(SYS)/AMOSProUnity_AMCAF.Lib
personal: $(SYS)/AMOSProUnity_Personal.Lib

# --- rest of AMOSProUnity_Compiler.batch ------------------------------------
$(SYS)/APUCmp: src/Compiler/APComp.s $(ASM_DEPS) | $(SYS)
	$(call status,Assembling APUCmp)
	$(call run_vamos,$(GENAM) FROM $< TO $@,APUCmp)

$(SYS)/Header_CLI.Lib: src/Compiler/Header.s $(ASM_DEPS) | $(SYS)
	$(call status,Assembling Header_CLI.Lib)
	$(call run_vamos,$(GENAM) FROM $< TO $@,Header_CLI.Lib)

$(SYS)/Header_Backstart.Lib: src/Compiler/Header_Backstart.s src/Compiler/Header.s $(ASM_DEPS) | $(SYS)
	$(call status,Assembling Header_Backstart.Lib)
	$(call run_vamos,$(GENAM) FROM $< TO $@,Header_Backstart.Lib)

# --- instruction checklist (not part of Build) -------------------------------
CHECKLIST_SRCS := $(LIB_SRC) src/APULib_Music/APUMusic_lib.s src/APULib_Compact/APUCompact_lib.s \
  src/APULib_Request/APURequest_lib.s src/APULib_IOPorts/APUIOPorts_lib.s

checklist: Instruction_List.Asc

Instruction_List.Asc: tools/Make_Checklist $(CHECKLIST_SRCS)
	$(call status,Creating checklist)
	tools/Make_Checklist $@ $(CHECKLIST_SRCS)

# --- compare against reference binaries -------------------------------------
# Compares every output with its version in git revision $(REF). Files no
# longer present there (e.g. AmosProUnity.Lib, removed in b61c973) are
# compared with the last revision that still had them. Never fails;
# results also go to logs/compare.txt.
compare:
	mkdir -p $(LOGS) $(TMP)/ref
	{ echo "Compare against $(REF) ($$(git rev-parse --short $(REF))) on $$(date '+%Y-%m-%d %H:%M:%S')"; \
	for f in $(ALL_OUTS); do \
	  ref=$(REF); \
	  if ! git cat-file -e "$$ref:$$f" 2>/dev/null; then \
	    del=$$(git log -1 --format=%H --diff-filter=D $(REF) -- "$$f"); \
	    if [ -n "$$del" ] && git cat-file -e "$$del^:$$f" 2>/dev/null; then ref="$$del^"; else printf '%-10s %s\n' NO-REF "$$f"; continue; fi; \
	  fi; \
	  if [ ! -f "$$f" ]; then printf '%-10s %s\n' MISSING "$$f"; continue; fi; \
	  r=$(TMP)/ref/$$(echo "$$f" | tr / _); \
	  git show "$$ref:$$f" > "$$r"; \
	  if cmp -s "$$r" "$$f"; then printf '%-10s %s\n' IDENTICAL "$$f"; \
	  else \
	    n=$$(cmp -l "$$r" "$$f" 2>/dev/null | wc -l); \
	    printf '%-10s %s (ref %s: %d bytes, new: %d bytes, %d bytes differ, first at offset %s)\n' DIFFERENT "$$f" "$$ref" \
	      $$(stat -c %s "$$r") $$(stat -c %s "$$f") $$n "$$(cmp "$$r" "$$f" 2>/dev/null | sed -n 's/.*byte \([0-9]*\).*/\1/p')"; \
	  fi; \
	done; } | tee $(LOGS)/compare.txt

# --- clean ------------------------------------------------------------------
# Leaves the git-tracked release binaries in $(OUT) alone; restore those
# with "git checkout -- $(OUT)" if wanted.
clean:
	rm -f $(TOOL_BINS) $(DIGEST_OUTS) Instruction_List.Asc
	rm -rf $(TMP)/* $(LOGS)/*
